{
  "name": "dsh-workbuddy-connect",
  "displayName": "WorkBuddy",
  "description": "将 WorkBuddy（国际版 / 国内版）的模型接入 DeepSeek Harness — bring WorkBuddy (Global & CN) models into DeepSeek Harness.",
  "icon": "./assets/icon.svg",
  "version": "0.1.0",
  "author": "sunzhengnan",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "workbuddy-ai",
    "codebuddy",
    "model-provider"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2",
    "@earendil-works/pi-ai": ">=0.85.1"
  }
}
